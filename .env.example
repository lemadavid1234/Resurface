# Postgres - Supabase-hosted, direct (non-pooled) connection.
# Get these from your Supabase project: Settings -> Database -> Direct connection.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your-database-password
POSTGRES_PORT=5432
POSTGRES_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co


OPENAI_API_KEY=sk-...


# Both optional - already default to localhost for normal local dev.
# Only need to change these when testing from another device (e.g. your phone)
# on the same network.
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Supabase Storage - screenshot image files.
# Use the service_role key specifically, never anon/public - this is
# server-side only and must never reach the frontend.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=screenshots
