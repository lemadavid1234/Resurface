# Copy to .env.test and fill in POSTGRES_PASSWORD.
# Get the password from: docker exec screenshotapp-db-1 printenv POSTGRES_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resurfaceapp
POSTGRES_PASSWORD=your-local-container-password
POSTGRES_DB=resurface_test
SUPABASE_URL=https://fake-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key-not-used
SUPABASE_BUCKET=screenshots
OPENAI_API_KEY=sk-fake-not-used-in-tests